# ─── FitMaster Pro — Environment Variables ───────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── AI Backend Server ────────────────────────────────────────────────────────
# URL-ul serverului tau de proxy AI (vezi /server)
# Local dev:  http://192.168.x.x:3000  (IP-ul masinii tale in reteaua locala)
# Deployed:   https://fitmaster-ai.onrender.com
EXPO_PUBLIC_AI_SERVER_URL=http://localhost:3000

# Secret partajat intre app si server (trebuie sa coincida cu APP_SECRET din server/.env)
EXPO_PUBLIC_AI_SERVER_SECRET=schimba-asta-cu-ceva-random

# ── Firebase ─────────────────────────────────────────────────────────────────
# Used for: Authentication (email/password), Firestore (sync user data),
#           Storage (progress photos)
#
# Steps:
#  1. Go to https://console.firebase.google.com
#  2. Create a project → add a Web app
#  3. Enable Authentication → Email/Password
#  4. Create Firestore Database (production mode)
#  5. Create Storage bucket
#  6. Copy the config values below from Project Settings → Your apps

EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSy...
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abc123
