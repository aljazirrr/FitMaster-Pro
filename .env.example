# ─── FitMaster Pro — Environment Variables ───────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Anthropic API (OBLIGATORIU pentru toate funcțiile AI) ────────────────────
# Obține cheia de la: https://console.anthropic.com/settings/keys
# Folosit de app direct pentru: meal plans, food macros, barcode scanner, workout plans
EXPO_PUBLIC_ANTHROPIC_API_KEY=sk-ant-...

# ── AI Backend Server (OPȚIONAL — pentru workout plans cu extended thinking) ─
# Dacă lași gol, app-ul folosește automat EXPO_PUBLIC_ANTHROPIC_API_KEY de mai sus.
#
# ⚠️  NU folosi "localhost" pe Android — emulatorul nu vede host-ul prin localhost!
#     - Emulator Android : http://10.0.2.2:3000
#     - Dispozitiv fizic  : http://192.168.X.X:3000  (IP-ul PC-ului tău, vezi ipconfig)
#     - iOS Simulator     : http://localhost:3000
EXPO_PUBLIC_AI_SERVER_URL=
EXPO_PUBLIC_AI_SERVER_SECRET=schimba-asta-cu-ceva-random

# ── Firebase ─────────────────────────────────────────────────────────────────
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSy...
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abc123
